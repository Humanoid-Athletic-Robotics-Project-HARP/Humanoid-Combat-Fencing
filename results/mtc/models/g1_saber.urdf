  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0.8307767239493009 0" xyz="0.0385 0.0 0.432"/>
    <parent link="torso_link"/>
    <child link="camera_bottom_screw_frame"/>
  </joint>
  <link name="camera_bottom_screw_frame"/>
  <joint name="camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="camera_bottom_screw_frame"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
<!-- Saber for the G1 29-DoF URDF: paste inside <robot>. Generated by fencing.saber.spec.
     Isaac Lab's URDF importer merges fixed joints by default: set merge_fixed_joints=False
     (or keep the blade_tip link) or the blade_tip frame disappears. -->
<joint name="saber_mount_joint" type="fixed">
  <parent link="right_wrist_yaw_link"/>
  <child link="saber"/>
  <origin xyz="0.1000 0.0000 0.0000" rpy="0.000000 -0.523599 0.000000"/>
</joint>
<link name="saber">
  <inertial>
    <origin xyz="0.23225 0 0" rpy="0 0 0"/>
    <mass value="0.2000"/>
    <inertia ixx="5.232500e-05" ixy="0" ixz="0" iyy="1.394553e-02" iyz="0" izz="1.393277e-02"/>
  </inertial>
  <visual>
    <origin xyz="0.4450 0 0" rpy="0 1.570796 0"/>
    <geometry><cylinder radius="0.012" length="0.75"/></geometry>
  </visual>
  <visual>
    <origin xyz="0.0650 0 0" rpy="0 0 0"/>
    <geometry><box size="0.01 0.07 0.1"/></geometry>
  </visual>
  <visual>
    <origin xyz="0 0 0" rpy="0 1.570796 0"/>
    <geometry><cylinder radius="0.015" length="0.12"/></geometry>
  </visual>
</link>
<joint name="blade_tip_joint" type="fixed">
  <parent link="saber"/>
  <child link="blade_tip"/>
  <origin xyz="0.8200 0 0" rpy="0 0 0"/>
</joint>
<link name="blade_tip"/>
<joint name="guard_joint" type="fixed">
  <parent link="saber"/>
  <child link="guard"/>
  <origin xyz="0.0700 0 0" rpy="0 0 0"/>
</joint>
<link name="guard"/>
</robot>
